# General settings

MODE='development'
FLASK_DEBUG=1
FLASK_APP='pyfedi.py'
PYTHONUNBUFFERED=1 #  Displays prints in console for debugging
SECRET_KEY='piefed'
SERVER_NAME='127.0.0.1:5000'


# Postgresql settings

POSTGRES_HOST=database
POSTGRES_PASSWORD=pyfedi
POSTGRES_USER=pyfedi
POSTGRES_DB=pyfedi
POSTGRES_RANDOM_ROOT_PASSWORD=yes

DATABASE_URL=postgresql+psycopg2://pyfedi:pyfedi@database/pyfedi


# Mail settings

MAIL_SERVER=''
MAIL_PORT=0
# Remove the below line if not using TLS - do not set it to False
MAIL_USE_TLS=True
MAIL_USERNAME=''
MAIL_PASSWORD=''
MAIL_FROM=''
MAIL_ERRORS=False


# Misc settings

RECAPTCHA_PUBLIC_KEY=''
RECAPTCHA_PRIVATE_KEY=''

CACHE_TYPE='FileSystemCache'
CACHE_DIR='/dev/shm/pyfedi'
CELERY_BROKER_URL='redis://localhost:6379/1'
CACHE_REDIS_URL='redis://localhost:6379/1'

BOUNCE_ADDRESS=''
BOUNCE_HOST=''
BOUNCE_USERNAME=''
BOUNCE_PASSWORD=''

SENTRY_DSN = ''

AWS_REGION = 'ap-southeast-2'

CLOUDFLARE_API_TOKEN = ''
CLOUDFLARE_ZONE_ID = ''

IPINFO_TOKEN = ''
